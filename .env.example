# Copy this file to .env and fill in the values

# PostgreSQL in Docker (see compose.yaml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Connection string the app uses
# Format: postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL=

# Owner of existing records and demo data; no default is used
LEGACY_OWNER_EMAIL=

# Application origin and session signing secret (runtime only)
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# SMTP: local Mailpit or production Resend; authentication is optional locally
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
